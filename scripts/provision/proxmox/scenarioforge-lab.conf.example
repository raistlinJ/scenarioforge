# ScenarioForge Proxmox installer configuration
#
# Format: one lowercase key=value per line. Blank lines and full-line comments
# are ignored. Values may be unquoted or wrapped in matching single/double
# quotes. The file is parsed as data and is never sourced as shell code.
#
# Precedence: built-in defaults < this file < SF_* environment < CLI flags.
# If passwords are stored here, protect the copy with: chmod 600 FILE

storage=local-lvm
snippet_storage=local
uplink_bridge=vmbr0
management_bridge=sfmgmt0
hitl_bridge=sfhitl0

core_vmid=9401
app_vmid=9402
participant_vmid=9403
# debian (minimal XFCE) or kali (XFCE and standard Kali tools)
participant_os=debian

app_management_cidr=172.31.250.2/24
core_management_cidr=172.31.250.3/24
core_hitl_cidr=10.254.200.3/24
participant_cidr=10.254.200.10/24

ssh_public_key=
# CORE VM login username: corevm
core_password=
# APP VM login username: scenarioforge
app_password=
# Participant VM login username: participant
participant_password=
# ScenarioForge Web UI administrator username: coreadmin
web_admin_password=

core_minimal_ref=main
core_ref=master
scenarioforge_ref=main
flag_generators_ref=5f612eecb8ff5df74a0e517d0de1e54385a62044

flag_generators=true
vulnhub=true
wait_minutes=90
no_wait=false
verbose=false
watch=false
interval=10
yes=false
dry_run=false
force=false

# --- Optional CyberAgentFlow and dedicated LLM interface (Kali only) ---
# Set participant_os=kali above and enable this to install the application.
# Source is the project at ../cyber-agent-flow; guests clone its upstream repo.
cyber_agent_flow=false
cyber_agent_flow_url=https://github.com/raistlinJ/cyber-agent-flow.git
cyber_agent_flow_ref=main
# Fixed IPv4 destination; the URL must use this same IP (no hostname resolution).
llm_provider_address=
llm_provider_url=
llm_provider_type=ollama_direct
llm_model=
# Reserve an unused static guest address on the selected egress network.
# Set its real gateway; no default route or DHCP is enabled on this interface.
llm_interface_cidr=
llm_gateway=
# Existing uplink bridge with access to the provider, separate from HITL/management.
# Empty uses uplink_bridge; a supplied bridge must already exist.
llm_bridge=
# Example: provider 192.0.2.20, URL https://192.0.2.20:443/v1.
# Do not use documentation addresses for a real installation.

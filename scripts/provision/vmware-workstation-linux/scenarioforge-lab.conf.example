# ScenarioForge VMware Workstation/Linux installer configuration
#
# Format: one lowercase key=value per line. Blank lines and full-line comments
# are ignored. Values may be unquoted or wrapped in matching single/double
# quotes. The file is parsed as data and is never sourced as shell code.
#
# Precedence: built-in defaults < this file < SF_* environment < CLI flags.
# If passwords are stored here, protect the copy with: chmod 600 FILE

lab_dir="/home/your-user/vmware/ScenarioForge-Lab"
# Management connects APP and CORE; an enabled host virtual adapter also
# lets your host reach those VMs. This network must already be configured:
# setting management_vmnet=vmnet3 does NOT create vmnet3 automatically.
management_vmnet=vmnet1

# HITL connects CORE and the participant on a separate exercise network.
# With managed HITL creation enabled (see manage_hitl_network), an unused
# hitl_vmnet=vmnet3 is created automatically with DHCP, NAT, and host access
# disabled. If the requested network is occupied and unsuitable, the installer
# selects another unused vmnet. Keep HITL separate from management.
hitl_vmnet=vmnet2

app_management_cidr=172.31.250.2/24
core_management_cidr=172.31.250.3/24
core_hitl_cidr=10.254.200.3/24
participant_cidr=10.254.200.10/24

ssh_public_key=
# CORE VM login username: corevm
core_password=
# APP VM login username: scenarioforge
app_password=
# Participant VM login username: participant
participant_password=
# ScenarioForge Web UI administrator username: coreadmin
web_admin_password=

core_minimal_ref=main
core_ref=master
scenarioforge_ref=main
flag_generators_ref=5f612eecb8ff5df74a0e517d0de1e54385a62044

flag_generators=true
vulnhub=true
wait_minutes=90
no_wait=false
headless=false
# Host shortcuts for the web UI and participant VM (independent of headless).
desktop_shortcut=true
verbose=false
watch=false
interval=10
yes=false
dry_run=false
force=false

# Participant: debian (default) or kali; both use 2048 MB RAM.
participant_os=debian

# Automatically create a dedicated isolated HITL network when needed.
manage_hitl_network=true
